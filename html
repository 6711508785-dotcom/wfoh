<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>5W1H DETECTIVE ADVENTURE - นักสืบจิ๋วผจญภัย ไขปริศนา 5W1H</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- เชื่อมต่อไฟล์ตกแต่งหน้าจอ -->
  <link rel="stylesheet" href="style.css">

  <!-- Three.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

  <!-- 3D Game Canvas -->
  <canvas id="game-canvas"></canvas>
  <div id="world-labels"></div>

  <!-- ================= HUD OVERLAY ================= -->
  <div id="hud">
    <div class="hud-top">
      <div class="hud-left">
        <div class="mission-tracker-card">
          <div class="mission-badge" id="hud-mission-badge">ภารกิจที่ 1 • ห้องเรียน ม.2/1</div>
          <div class="mission-title" id="hud-mission-title">ปริศนาโทรศัพท์หาย</div>
          <div class="evidence-progress">
            <div class="progress-bar-bg">
              <div class="progress-bar-fill" id="hud-progress-fill" style="width: 0%"></div>
            </div>
            <span class="progress-text" id="hud-progress-text">0/4</span>
          </div>
          <div class="compass-hint" id="hud-compass">
            <span>🧭</span> <span id="hud-compass-text">เดินสำรวจหาเบาะแสเรืองแสงในห้องเรียน</span>
          </div>
        </div>
      </div>

      <div class="hud-right">
        <div class="hud-stat-pill" title="ผู้เล่นที่ออนไลน์ในโรงเรียน">
          <span class="online-dot"></span>
          <span id="hud-online-count">1 คนออนไลน์</span>
        </div>
        <div class="hud-stat-pill">
          <span>🕵️</span>
          <span id="hud-player-name">นักสืบ</span>
        </div>
        <div class="hud-stat-pill">
          <span>⭐</span>
          <span id="hud-score">0 คะแนน</span>
        </div>
        <button class="hud-btn" onclick="openDressingRoom()" title="แต่งตัวนักสืบ">👕 แต่งตัว</button>
        <button class="hud-btn" onclick="toggleOnlineModal()" title="รายชื่อเพื่อนและแชท">👥 ออนไลน์</button>
        <button class="hud-btn" onclick="openMissionSelect()" title="เลือกภารกิจ">📋 ภารกิจ</button>
        <button class="hud-btn" id="btn-sound" onclick="toggleSound()" title="เปิด/ปิดเสียง">🔊</button>
      </div>
    </div>

    <!-- Evidence Log Bar -->
    <div class="evidence-log-bar" id="hud-evidence-pills"></div>

    <!-- Interaction Prompt -->
    <div id="interact-prompt" onclick="triggerInteract()">
      <span class="key-badge">E</span>
      <span id="interact-label">สำรวจหลักฐาน</span>
    </div>

    <!-- Mobile Controls -->
    <div id="mobile-controls">
      <div id="joystick-zone">
        <div id="joystick-stick"></div>
      </div>
      <div class="mobile-actions">
        <button class="mob-btn mob-btn-interact" id="mob-interact-btn" onclick="triggerInteract()">🔍<br>สำรวจ</button>
        <button class="mob-btn mob-btn-jump" id="mob-jump-btn">⬆️<br>กระโดด</button>
      </div>
    </div>
  </div>

  <!-- ================= SCREEN 1: HOME ================= -->
  <div id="screen-home" class="screen-overlay">
    <div class="glass-card" style="text-align: center; max-width: 650px;">
      <div class="game-logo-badge">🎮 รายวิชาการออกแบบและเทคโนโลยี • ชั้น ม.2</div>
      <h1 class="game-title-en">5W1H DETECTIVE ADVENTURE</h1>
      <div class="game-title-th">นักสืบจิ๋วผจญภัย ไขปริศนา 5W1H</div>
      <p style="color: #94a3b8; font-size: 0.98rem; line-height: 1.6; margin-bottom: 24px;">
        ออกสำรวจโรงเรียน 3D สไตล์การ์ตูน รวบรวมหลักฐานจากสถานที่จริง และใช้หลักการตั้งคำถาม 
        <strong style="color: #fbbf24;">Who • What • When • Where • Why • How</strong> 
        เพื่อไขปริศนาและแก้ไขปัญหาอย่างเป็นระบบ!
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;">
        <button class="btn btn-primary" onclick="goToRegister()">🚀 เริ่มสืบสวน (Start Game)</button>
        <button class="btn btn-purple" onclick="openDressingRoom()">👕 แต่งตัวนักสืบ 3D</button>
        <button class="btn btn-secondary" onclick="showScreen('screen-controls')">🎮 วิธีควบคุม</button>
        <button class="btn btn-secondary" onclick="openLeaderboard()">🏆 ตารางคะแนนออนไลน์</button>
      </div>
      <div style="margin-top: 20px; font-size: 0.85rem; color: #34d399; font-weight: 500;">
        🌐 เชื่อมต่อเซิร์ฟเวอร์โรงเรียนออนไลน์อัตโนมัติ (เล่นพร้อมกันกับเพื่อนได้ทันที)
      </div>
    </div>
  </div>

  <!-- ================= SCREEN 2: CONTROLS GUIDE ================= -->
  <div id="screen-controls" class="screen-overlay hidden">
    <div class="glass-card">
      <div class="modal-header">
        <div>
          <h2 style="font-size: 1.5rem; color: #fbbf24;">🎮 คู่มือการควบคุม (Controls Guide)</h2>
          <p style="color: #94a3b8; font-size: 0.9rem;">รองรับทั้งคอมพิวเตอร์ (PC) และโทรศัพท์มือถือ / แท็บเล็ต</p>
        </div>
        <button class="btn btn-secondary btn-sm" onclick="showScreen('screen-home')">✕ ปิด</button>
      </div>
      <div class="controls-grid">
        <div class="control-item">
          <div class="control-icon">⌨️</div>
          <div>
            <strong>เดินสำรวจ (PC)</strong>
            <div style="color: #94a3b8; font-size: 0.88rem;">กดปุ่ม <span style="color:#fbbf24">W A S D</span> หรือปุ่มลูกศร เพื่อเคลื่อนที่ไปรอบโรงเรียน</div>
          </div>
        </div>
        <div class="control-item">
          <div class="control-icon">🖱️</div>
          <div>
            <strong>หมุนมุมกล้อง (Camera)</strong>
            <div style="color: #94a3b8; font-size: 0.88rem;">คลิกซ้ายค้างแล้วลากเมาส์ (หรือปัดนิ้วบนหน้าจอฝั่งขวา)</div>
          </div>
        </div>
        <div class="control-item">
          <div class="control-icon">⬆️</div>
          <div>
            <strong>กระโดด (Jump)</strong>
            <div style="color: #94a3b8; font-size: 0.88rem;">กดปุ่ม <span style="color:#fbbf24">Spacebar</span> หรือปุ่มกระโดดบนหน้าจอมือถือ</div>
          </div>
        </div>
        <div class="control-item">
          <div class="control-icon">🔍</div>
          <div>
            <strong>โต้ตอบ / เก็บหลักฐาน</strong>
            <div style="color: #94a3b8; font-size: 0.88rem;">เดินเข้าใกล้จุดเรืองแสงแล้วกด <span style="color:#fbbf24">E</span> หรือคลิกปุ่มสำรวจ</div>
          </div>
        </div>
        <div class="control-item">
          <div class="control-icon">📱</div>
          <div>
            <strong>การเล่นบนโทรศัพท์ (Mobile)</strong>
            <div style="color: #94a3b8; font-size: 0.88rem;">ใช้จอยสติ๊กเสมือนมุมซ้ายล่างเพื่อเดิน และปุ่มมุมขวาล่างเพื่อสำรวจ/กระโดด</div>
          </div>
        </div>
        <div class="control-item">
          <div class="control-icon">👕</div>
          <div>
            <strong>แต่งตัว & เล่นกับเพื่อน</strong>
            <div style="color: #94a3b8; font-size: 0.88rem;">ปรับแต่งชุดนักสืบ 3D และเห็นเพื่อนร่วมห้องเดินสำรวจในเซิร์ฟเวอร์เดียวกัน</div>
          </div>
        </div>
      </div>
      <div style="margin-top: 22px; text-align: center;">
        <button class="btn btn-primary" onclick="goToRegister()">พร้อมแล้ว ไปลงทะเบียนนักสืบ! ➡️</button>
      </div>
    </div>
  </div>

  <!-- ================= SCREEN 3: PLAYER REGISTRATION ================= -->
  <div id="screen-register" class="screen-overlay hidden">
    <div class="glass-card" style="max-width: 520px;">
      <div class="modal-header">
        <div>
          <h2 style="font-size: 1.5rem; color: #38bdf8;">🪪 บัตรประจำตัวนักสืบจิ๋ว</h2>
          <p style="color: #94a3b8; font-size: 0.9rem;">กรอกข้อมูลเพื่อบันทึกคะแนนและแสดงชื่อบนศีรษะในเซิร์ฟเวอร์</p>
        </div>
        <button class="btn btn-secondary btn-sm" onclick="showScreen('screen-home')">← กลับ</button>
      </div>
      <div class="form-group">
        <label for="input-name">ชื่อ - นามสกุล หรือ ชื่อเล่นนักสืบ</label>
        <input type="text" id="input-name" class="form-input" placeholder="เช่น ด.ช. กล้าหาญ ใจดี" maxlength="25" />
      </div>
      <div class="form-group">
        <label for="input-no">เลขที่ / ห้องเรียน</label>
        <input type="text" id="input-no" class="form-input" placeholder="เช่น เลขที่ 15 ม.2/1" maxlength="15" />
      </div>
      <div style="display: flex; gap: 10px; margin-bottom: 14px;">
        <button class="btn btn-purple" style="flex: 1;" onclick="openDressingRoom()">👕 ปรับแต่งชุดและทรงผม 3D</button>
      </div>
      <button class="btn btn-primary" style="width: 100%;" onclick="submitRegistration()">เข้าสู่แฟ้มภารกิจ 5W1H ➡️</button>
    </div>
  </div>

  <!-- ================= SCREEN 4: DRESSING ROOM (CHARACTER CUSTOMIZATION) ================= -->
  <div id="screen-wardrobe" class="screen-overlay hidden">
    <div class="glass-card" style="max-width: 880px;">
      <div class="modal-header">
        <div>
          <h2 style="font-size: 1.5rem; color: #c084fc;">👕 ห้องแต่งตัวนักสืบ 3D (Dressing Room)</h2>
          <p style="color: #94a3b8; font-size: 0.9rem;">ลากเมาส์หรือนิ้วบนตัวละครเพื่อหมุนดูรอบตัว 360° • ชุดใหม่ซิงก์ออนไลน์ทันที!</p>
        </div>
        <button class="btn btn-secondary btn-sm" onclick="closeDressingRoom()">✕ ปิด</button>
      </div>

      <div class="wardrobe-layout">
        <!-- Left: 3D Preview -->
        <div class="preview-box">
          <canvas id="preview-canvas"></canvas>
          <div class="preview-hint">🔄 ลากเพื่อหมุนดูรอบตัว 360°</div>
          <div style="margin-top: 10px; display: flex; gap: 8px;">
            <button class="btn btn-secondary btn-sm" onclick="randomizeAppearance()">🎲 สุ่มชุดสุดแนว</button>
          </div>
        </div>

        <!-- Right: Customization Options -->
        <div class="wardrobe-controls">
          <div class="custom-section">
            <h4>🧑 สีผิว (Skin Tone)</h4>
            <div class="swatch-grid" id="opt-skin"></div>
          </div>

          <div class="custom-section">
            <h4>💇 ทรงผม (Hairstyle - 10 สไตล์)</h4>
            <div class="option-grid" id="opt-hair"></div>
          </div>

          <div class="custom-section">
            <h4>🎨 สีผม (Hair Color)</h4>
            <div class="swatch-grid" id="opt-haircolor"></div>
          </div>

          <div class="custom-section">
            <h4>👔 ชุดเครื่องแบบและคอสตูมฮาๆ (Outfit)</h4>
            <div class="option-grid" id="opt-outfit"></div>
          </div>

          <div class="custom-section">
            <h4>👓 แว่นตา (Eyewear)</h4>
            <div class="option-grid" id="opt-glasses"></div>
          </div>

          <div class="custom-section">
            <h4>🎩 หมวกและเครื่องหัว (Headgear)</h4>
            <div class="option-grid" id="opt-hat"></div>
          </div>
        </div>
      </div>

      <div style="margin-top: 18px; display: flex; justify-content: flex-end; gap: 10px;">
        <button class="btn btn-success" onclick="saveAppearanceAndClose()">✅ บันทึกชุดนักสืบและเข้าเล่น</button>
      </div>
    </div>
  </div>

  <!-- ================= SCREEN 5: MISSION SELECT ================= -->
  <div id="screen-missions" class="screen-overlay hidden">
    <div class="glass-card" style="max-width: 820px;">
      <div class="modal-header">
        <div>
          <h2 style="font-size: 1.5rem; color: #fbbf24;">📋 เลือกภารกิจสืบสวน (Select Mission)</h2>
          <p style="color: #94a3b8; font-size: 0.9rem;">นักสืบ: <span id="select-player-label" style="color:#38bdf8; font-weight:600;">-</span> | คะแนนรวม: <span id="select-total-score" style="color:#fbbf24; font-weight:600;">0</span></p>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <button class="btn btn-purple btn-sm" onclick="openDressingRoom()">👕 แต่งตัว</button>
          <button class="btn btn-secondary btn-sm" onclick="openLeaderboard()">🏆 อันดับออนไลน์</button>
          <button class="btn btn-secondary btn-sm" onclick="showScreen('screen-home')">🏠 หน้าแรก</button>
        </div>
      </div>

      <div class="mission-cards-grid" id="mission-cards-container"></div>

      <div style="margin-top: 20px; text-align: center; color: #94a3b8; font-size: 0.85rem;">
        💡 คำแนะนำ: เดินสำรวจในโลก 3D เพื่อหาจุดเรืองแสงสีทอง เมื่อเก็บหลักฐานครบ 4 ชิ้น ระบบจะเปิดหน้าต่างวิเคราะห์ 5W1H ทันที
      </div>
    </div>
  </div>

  <!-- ================= SCREEN 6: EVIDENCE POPUP ================= -->
  <div id="screen-evidence" class="screen-overlay hidden">
    <div class="glass-card" style="max-width: 540px; text-align: center;">
      <div class="evidence-icon-large" id="ev-modal-icon">📱</div>
      <div class="mission-badge" id="ev-modal-tag">พบหลักฐานใหม่!</div>
      <h3 style="font-size: 1.35rem; color: #f8fafc; margin-bottom: 10px;" id="ev-modal-title">ชื่อหลักฐาน</h3>
      <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 14px; padding: 16px; text-align: left; margin-bottom: 18px; line-height: 1.6; color: #e2e8f0;" id="ev-modal-desc">
        รายละเอียดคำให้การหรือหลักฐาน...
      </div>
      <div style="color: #34d399; font-weight: 600; margin-bottom: 16px;" id="ev-modal-counter">รวบรวมหลักฐานแล้ว 1 / 4 ชิ้น</div>
      <button class="btn btn-primary" style="width: 100%;" onclick="closeEvidenceModal()">บันทึกข้อมูลลงสมุดนักสืบ ✅</button>
    </div>
  </div>

  <!-- ================= SCREEN 7: 5W1H ANALYSIS QUIZ ================= -->
  <div id="screen-quiz" class="screen-overlay hidden">
    <div class="glass-card" style="max-width: 720px;">
      <div class="modal-header">
        <div>
          <span class="mission-badge" id="quiz-mission-name">วิเคราะห์ข้อมูล 5W1H</span>
          <h2 style="font-size: 1.3rem; color: #f8fafc;">แบบทดสอบวิเคราะห์ปัญหาตามหลัก 5W1H</h2>
        </div>
        <div style="text-align: right;">
          <div style="font-size: 0.85rem; color: #94a3b8;">ข้อที่ <span id="quiz-step-num" style="color:#fbbf24; font-weight:700;">1</span> / 6</div>
          <div style="font-size: 0.9rem; color: #34d399; font-weight: 600;">คะแนนด่านนี้: <span id="quiz-current-score">0</span></div>
        </div>
      </div>

      <div class="w1h-tabs" id="quiz-w1h-tabs"></div>

      <div class="question-box">
        <div class="w1h-tag" id="quiz-w1h-tag">WHO (ใครเกี่ยวข้องกับปัญหา)</div>
        <div class="question-text" id="quiz-question-text">คำถาม...</div>
        <div class="options-grid" id="quiz-options-container"></div>
        <div class="explanation-box hidden" id="quiz-explanation-box">
          <strong id="quiz-feedback-title" style="display:block; margin-bottom:4px;">เฉลยและคำอธิบาย:</strong>
          <span id="quiz-explanation-text">คำอธิบาย...</span>
        </div>
      </div>

      <div style="margin-top: 18px; display: flex; justify-content: space-between; align-items: center;">
        <button class="btn btn-secondary btn-sm" onclick="toggleEvidenceReview()">📂 ดูหลักฐานที่เก็บมา</button>
        <button class="btn btn-primary hidden" id="quiz-next-btn" onclick="nextQuizQuestion()">ข้อถัดไป ➡️</button>
      </div>

      <!-- Collapsible Evidence Review -->
      <div id="quiz-evidence-drawer" class="hidden" style="margin-top: 14px; background: rgba(15,23,42,0.85); padding: 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); font-size: 0.88rem;">
        <strong style="color: #fbbf24; display: block; margin-bottom: 6px;">📌 สรุปหลักฐานที่รวบรวมได้:</strong>
        <ul id="quiz-evidence-list" style="padding-left: 18px; color: #cbd5e1; line-height: 1.5;"></ul>
      </div>
    </div>
  </div>

  <!-- ================= SCREEN 8: MISSION SUMMARY ================= -->
  <div id="screen-summary" class="screen-overlay hidden">
    <div class="glass-card" style="max-width: 560px; text-align: center;">
      <div class="mission-badge" id="sum-badge">ปิดคดีสำเร็จ!</div>
      <h2 style="font-size: 1.75rem; color: #fbbf24; margin-bottom: 4px;" id="sum-title">ภารกิจที่ 1 เสร็จสมบูรณ์</h2>
      <div class="stars-display" id="sum-stars">⭐⭐⭐</div>
      <div style="font-size: 1.35rem; font-weight: 700; color: #34d399; margin-bottom: 10px;" id="sum-score-text">ได้รับ 600 / 600 คะแนน</div>
      <p style="color: #e2e8f0; background: rgba(56, 189, 248, 0.12); border: 1px solid rgba(56, 189, 248, 0.3); padding: 14px; border-radius: 12px; margin-bottom: 20px; line-height: 1.5;" id="sum-encouragement">
        ยอดเยี่ยมมากนักสืบ! คุณวิเคราะห์ข้อมูล 5W1H ได้อย่างแม่นยำ
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: center;">
        <button class="btn btn-primary" id="sum-next-mission-btn" onclick="goNextMission()">ภารกิจถัดไป ➡️</button>
        <button class="btn btn-secondary" onclick="replayCurrentMission()">🔄 เล่นภารกิจนี้ซ้ำ</button>
        <button class="btn btn-secondary" onclick="openLeaderboard()">🏆 ดูตารางคะแนน</button>
      </div>
    </div>
  </div>

  <!-- ================= SCREEN 9: LEADERBOARD ================= -->
  <div id="screen-leaderboard" class="screen-overlay hidden">
    <div class="glass-card" style="max-width: 780px;">
      <div class="modal-header">
        <div>
          <h2 style="font-size: 1.5rem; color: #fbbf24;">🏆 ทำเนียบนักสืบ 5W1H ออนไลน์ (Server Leaderboard)</h2>
          <p style="color: #94a3b8; font-size: 0.9rem;">แสดงคะแนนรวมและคะแนนแยกตามภารกิจของผู้เล่นทุกคนในเซิร์ฟเวอร์</p>
        </div>
        <button class="btn btn-secondary btn-sm" onclick="closeLeaderboard()">✕ ปิด</button>
      </div>
      <div style="overflow-x: auto;">
        <table class="leaderboard-table">
          <thead>
            <tr>
              <th>อันดับ</th>
              <th>ชื่อนักสืบ</th>
              <th>เลขที่/ห้อง</th>
              <th>ภารกิจ 1</th>
              <th>ภารกิจ 2</th>
              <th>ภารกิจ 3</th>
              <th>คะแนนรวม</th>
            </tr>
          </thead>
          <tbody id="leaderboard-tbody"></tbody>
        </table>
      </div>
      <div style="margin-top: 18px; display: flex; justify-content: space-between; align-items: center;">
        <button class="btn btn-secondary btn-sm" onclick="resetLocalPlayer()">🗑️ รีเซ็ตข้อมูลเครื่องนี้</button>
        <button class="btn btn-primary btn-sm" onclick="closeLeaderboard()">กลับสู่เกม 🎮</button>
      </div>
    </div>
  </div>

  <!-- ================= SCREEN 10: ONLINE PLAYERS & CHAT MODAL ================= -->
  <div id="screen-online" class="screen-overlay hidden">
    <div class="glass-card" style="max-width: 540px;">
      <div class="modal-header">
        <div>
          <h2 style="font-size: 1.4rem; color: #34d399;">🌐 นักสืบที่ออนไลน์ในโรงเรียนตอนนี้</h2>
          <p style="color: #94a3b8; font-size: 0.85rem;">เซิร์ฟเวอร์กลาง: ห้องเรียนรวม 5W1H (Real-Time Shared Server)</p>
        </div>
        <button class="btn btn-secondary btn-sm" onclick="toggleOnlineModal()">✕ ปิด</button>
      </div>

      <div class="online-list" id="online-players-list"></div>

      <div style="margin-top: 14px;">
        <label style="display:block; font-size:0.85rem; color:#cbd5e1; margin-bottom:6px;">💬 ส่งข้อความทักทายเพื่อน (แสดงบนศีรษะในฉาก 3D):</label>
        <div class="chat-box-row">
          <input type="text" id="chat-input" class="form-input" placeholder="พิมพ์ข้อความสั้นๆ เช่น หลักฐานอยู่ตรงไหน..." maxlength="45" onkeydown="if(event.key==='Enter') sendChatMessage()" />
          <button class="btn btn-primary btn-sm" onclick="sendChatMessage()">ส่ง</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast">ข้อความแจ้งเตือน</div>

  <!-- เชื่อมต่อไฟล์ระบบเกม 3D และตรรกะทั้งหมด -->
  <script src="game.js"></script>
</body>
</html>
